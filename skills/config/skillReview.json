{
  "enabled": true,
  "intervalHours": 72,
  "firstRunLookbackHours": 24,
  "skillsDir": "runtime/dsh/skills",
  "stateFile": "runtime/skill-review-state.json",
  "logFile": "runtime/skill-review.log",
  "model": {
    "provider": "dahuangf",
    "baseUrl": "https://tokens.dahuangf.com/v1",
    "model": "gpt-6.1-sol",
    "apiKeyEnv": "DAHUANGF_API_KEY",
    "timeoutSeconds": 180
  },
  "fallback": {
    "provider": "qwen",
    "baseUrl": "https://dashscope.aliyuncs.com/compatible-mode/v1",
    "model": "qwen3.8-flash",
    "apiKeyEnv": "DASHSCOPE_API_KEY",
    "timeoutSeconds": 300
  },
  "maxIterations": 8,
  "maxSkillsPerRun": 3,
  "minTurns": 4,
  "transcriptChars": 14000,
  "notifyQQ": false,
  "autoCreate": true,
  "stageUpdates": true
}
