{
  "version": 1,
  "services": {
    "tts": {
      "baseURL": "http://127.0.0.1:7862/v1",
      "management": "managed",
      "model": "breeze",
      "dialect": "breeze",
      "timeoutSeconds": 3600,
      "healthPath": "/health",
      "apiKeyEnv": "SYNLOVE_TTS_API_KEY",
      "format": "wav"
    },
    "asr": {
      "baseURL": "http://127.0.0.1:8081/v1",
      "management": "managed",
      "model": "small",
      "dialect": "whisper",
      "timeoutSeconds": 1800,
      "healthPath": "/health",
      "apiKeyEnv": "SYNLOVE_ASR_API_KEY"
    },
    "core": {
      "baseURL": "http://127.0.0.1:8790/v1",
      "management": "managed",
      "apiKeyEnv": "SYNLOVE_CORE_API_KEY",
      "timeoutSeconds": 240,
      "upstreamURL": "http://127.0.0.1:3082"
    },
    "reminders": {
      "baseURL": "http://127.0.0.1:8791/v1",
      "management": "managed",
      "apiKeyEnv": "SYNLOVE_REMINDERS_API_KEY",
      "timeoutSeconds": 60
    },
    "digest": {
      "baseURL": "http://127.0.0.1:8792/v1",
      "management": "managed",
      "apiKeyEnv": "SYNLOVE_DIGEST_API_KEY",
      "timeoutSeconds": 900
    },
    "video": {
      "baseURL": "http://127.0.0.1:8793/v1",
      "management": "managed",
      "apiKeyEnv": "SYNLOVE_VIDEO_API_KEY",
      "timeoutSeconds": 3600
    },
    "history": {
      "baseURL": "http://127.0.0.1:8794/v1",
      "management": "managed",
      "apiKeyEnv": "SYNLOVE_HISTORY_API_KEY",
      "timeoutSeconds": 120
    },
    "coding": {
      "baseURL": "http://127.0.0.1:8795/v1",
      "management": "managed",
      "apiKeyEnv": "SYNLOVE_CODING_API_KEY",
      "timeoutSeconds": 1800
    },
    "crawler": {
      "baseURL": "http://127.0.0.1:8796/v1",
      "management": "managed",
      "apiKeyEnv": "SYNLOVE_CRAWLER_API_KEY",
      "timeoutSeconds": 300
    },
    "memory": {
      "baseURL": "http://127.0.0.1:8797/v1",
      "management": "managed",
      "mode": "local",
      "apiKeyEnv": "SYNLOVE_MEMORY_API_KEY",
      "timeoutSeconds": 120,
      "timelineDir": "runtime/dsh/timeline",
      "graphDir": "runtime/dsh/graph"
    },
    "state": {
      "baseURL": "http://127.0.0.1:8798/v1",
      "management": "managed",
      "mode": "local",
      "apiKeyEnv": "SYNLOVE_STATE_API_KEY",
      "timeoutSeconds": 120,
      "databasePath": "runtime/dsh/weixin-state.db"
    },
    "qqstate": {
      "baseURL": "http://127.0.0.1:8799/v1",
      "management": "managed",
      "mode": "local",
      "apiKeyEnv": "SYNLOVE_QQSTATE_API_KEY",
      "timeoutSeconds": 120,
      "databasePath": "runtime/dsh/qq-state.db"
    },
    "observation": {
      "baseURL": "http://127.0.0.1:8800/v1",
      "management": "managed",
      "mode": "local",
      "apiKeyEnv": "SYNLOVE_OBSERVATION_API_KEY",
      "timeoutSeconds": 120,
      "databasePath": "runtime/observations.sqlite"
    },
    "session": {
      "baseURL": "http://127.0.0.1:8801/v1",
      "management": "managed",
      "mode": "local",
      "apiKeyEnv": "SYNLOVE_SESSION_API_KEY",
      "timeoutSeconds": 120,
      "rootDir": "runtime/dsh/sessions",
      "compression": "zstd"
    },
    "rsshub": {
      "baseURL": "http://127.0.0.1:1200",
      "management": "managed",
      "timeoutSeconds": 30
    },
    "opencode": {
      "baseURL": "http://127.0.0.1:4096",
      "management": "managed",
      "timeoutSeconds": 60
    },
    "llm": {
      "baseURL": "http://127.0.0.1:8080/v1",
      "management": "external",
      "provider": "gemma-local",
      "model": "gemma-4-E4B-it-Q4_K_M",
      "timeoutSeconds": 240,
      "healthPath": "/health",
      "apiKeyEnv": "SYNLOVE_LLM_API_KEY"
    }
  }
}
