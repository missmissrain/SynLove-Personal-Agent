{
  "version": 1,
  "services": {
    "tts": {
      "baseURL": "http://127.0.0.1:7862/v1",
      "management": "external",
      "model": "your-tts-model",
      "apiKeyEnv": "SYNLOVE_TTS_API_KEY",
      "timeoutSeconds": 300
    },
    "asr": {
      "baseURL": "http://127.0.0.1:8081/v1",
      "management": "external",
      "model": "your-asr-model",
      "apiKeyEnv": "SYNLOVE_ASR_API_KEY",
      "timeoutSeconds": 300
    },
    "llm": {
      "baseURL": "http://127.0.0.1:8080/v1",
      "management": "external",
      "model": "your-llm-model",
      "apiKeyEnv": "SYNLOVE_LLM_API_KEY",
      "timeoutSeconds": 240
    },
    "core": {
      "baseURL": "http://127.0.0.1:8790/v1",
      "management": "managed",
      "upstreamURL": "http://127.0.0.1:3082",
      "apiKeyEnv": "SYNLOVE_CORE_API_KEY",
      "timeoutSeconds": 240
    },
    "reminders": {
      "implementation": "backend",
      "baseURL": "http://127.0.0.1:8791/v1",
      "management": "managed",
      "apiKeyEnv": "SYNLOVE_REMINDERS_API_KEY",
      "timeoutSeconds": 60,
      "databasePath": "runtime/reminders.db"
    },
    "digest": {
      "implementation": "backend",
      "baseURL": "http://127.0.0.1:8792/v1",
      "management": "managed",
      "apiKeyEnv": "SYNLOVE_DIGEST_API_KEY",
      "timeoutSeconds": 900,
      "databasePath": "runtime/newsDigest.db"
    },
    "video": {
      "implementation": "backend",
      "baseURL": "http://127.0.0.1:8793/v1",
      "management": "managed",
      "apiKeyEnv": "SYNLOVE_VIDEO_API_KEY",
      "timeoutSeconds": 3600,
      "workDir": "runtime/videoService"
    },
    "crawler": {
      "implementation": "backend",
      "baseURL": "http://127.0.0.1:8796/v1",
      "management": "managed",
      "apiKeyEnv": "SYNLOVE_CRAWLER_API_KEY",
      "timeoutSeconds": 300
    },
    "memory": {
      "baseURL": "http://127.0.0.1:8797/v1",
      "management": "managed",
      "mode": "local",
      "apiKeyEnv": "SYNLOVE_MEMORY_API_KEY",
      "timeoutSeconds": 120,
      "timelineDir": "runtime/timeline",
      "graphDir": "runtime/graph"
    },
    "state": {
      "baseURL": "http://127.0.0.1:8798/v1",
      "management": "managed",
      "mode": "local",
      "apiKeyEnv": "SYNLOVE_STATE_API_KEY",
      "timeoutSeconds": 120,
      "databasePath": "runtime/weixin-state.db"
    },
    "qqstate": {
      "baseURL": "http://127.0.0.1:8799/v1",
      "management": "managed",
      "mode": "local",
      "apiKeyEnv": "SYNLOVE_QQSTATE_API_KEY",
      "timeoutSeconds": 120,
      "databasePath": "runtime/qq-state.db"
    },
    "observation": {
      "baseURL": "http://127.0.0.1:8800/v1",
      "management": "managed",
      "mode": "local",
      "apiKeyEnv": "SYNLOVE_OBSERVATION_API_KEY",
      "timeoutSeconds": 120,
      "databasePath": "runtime/observation.db"
    },
    "session": {
      "baseURL": "http://127.0.0.1:8801/v1",
      "management": "managed",
      "mode": "local",
      "apiKeyEnv": "SYNLOVE_SESSION_API_KEY",
      "timeoutSeconds": 120,
      "rootDir": "runtime/sessions",
      "compression": "zstd"
    },
    "rsshub": {
      "baseURL": "http://127.0.0.1:1200",
      "management": "external",
      "timeoutSeconds": 30
    },
    "opencode": {
      "baseURL": "http://127.0.0.1:4096",
      "management": "external",
      "timeoutSeconds": 60
    }
  }
}
