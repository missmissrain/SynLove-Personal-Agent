{
  "enabled": true,
  "terminalRoot": "PRODUCTION_ROOT/repos/terminal-pc",
  "terminalConfig": "config/ServerConfig.json",
  "devices": [
    "tianxuanLaptop",
    "androidGateway"
  ],
  "sampleSeconds": 90,
  "maxModelCallsPerHour": 8,
  "maxChatsPerDay": 6,
  "minChatIntervalSeconds": 1800,
  "speechExpiresSeconds": 90,
  "utcOffsetMinutes": 480,
  "quietHours": [
    "23:00",
    "08:00"
  ],
  "activity": "auto",
  "preferredChannel": "auto",
  "voiceOutputs": {
    "tianxuanLaptop": "tianxuanLaptop"
  },
  "allowSpeaker": {
    "tianxuanLaptop": true,
    "sonyXperia5III": true
  },
  "dryRun": false,
  "presenceIntervalSeconds": 90,
  "presenceTtlSeconds": 7200,
  "presenceBluetoothPrior": true,
  "presenceBluetoothIdleSeconds": 1800,
  "presenceAbsenceSeconds": 900,
  "presenceAwayHoldSeconds": 300
}
