# 保证不进仓库的内容（密钥 / 人格 / 日志 / 真实数据）
config/secrets.json
config/secrets.json.bak*
config/modelConfig.json
config/modelConfig.json.bak*
config/weixinProfile.patch.yml
config/console.env
config/serviceConfig.json
config/backendService.json
config/*Profile.patch.yml
config/modelOnly.patch.yml
config/harnessTuning.json
*.sqlite
*.sqlite-wal
*.sqlite-shm
*.bak
*.bak-*

# 运行产物：日志里有聊天内容与账号指纹
/runtime/
*.log
logs/

# 真实数据（通常位于用户目录，这里再挡一层）
*.db
*.db-wal
*.db-shm
weixin-route-state.json
timeline/
graph/

# 历史快照与审计产物（可能残留旧配置）
备份/
审计产物/

# Python / Node
__pycache__/
*.pyc
node_modules/
.venv/
.serviceEnvs/
/vendor/
.vite/
dist/
!backend/**/dist/
!backend/**/dist/**

# 本机模型权重 / 服务产物（体积大或含隐私）
models/
/backend/.DS_Store
newsDigest/config/newsDigest.json
/runtime/tts/
/config/remoteControl.json
/config/remoteControlKnownHosts
/remoteControl/接入验证报告.md
/runtime/downloads/
.last_pushed_sha

# 第三方大件（自己 clone，不进仓库）
kugou/KuGouMusicApi/
rsshub/RSSHub/

# 酷狗账号凭据与设备指纹
kugou/config/auth.json
kugou/config/state.json

# 进程号与队列状态
*.pid
kugou-player-state.json

